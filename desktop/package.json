{
  "name": "agentrelay-desktop",
  "version": "0.1.0",
  "description": "Cliente de escritorio del terminal remoto de la Mac (via hub)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac dir",
    "build:win": "electron-builder --win portable",
    "build:linux": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.agentrelay.desktop",
    "productName": "AgentRelay",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "server/**",
      "node_modules/**"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Development"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  }
}
