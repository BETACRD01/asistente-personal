# Conexion al Hub (VPS)
HUB_WS_URL=wss://agentrelay.duckdns.org/ws/mac
DEVICE_TOKEN=Rfihtd_-FEP_6GBrTdtDY5CUNFQ2mz4t1Vgfi4epbNA

# === Proveedor de IA (estilo opencode/codex) ===
# Usa: python configure.py   para elegirlo facilmente
#
# LLM_PROVIDER=ollama        -> Local, gratis (requiere Ollama)
# LLM_PROVIDER=gemini        -> Google Gemini (AI Studio, con API key)
# LLM_PROVIDER=vertex_ai     -> Google Vertex AI (login con tu cuenta, sin key)
# LLM_PROVIDER=openai        -> GPT-4o
# LLM_PROVIDER=anthropic     -> Claude
# LLM_PROVIDER=groq          -> Rapido y barato
# LLM_PROVIDER=openrouter    -> Muchos modelos
LLM_PROVIDER=ollama
LLM_MODEL=

# Ollama local (si usas LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434

# Vertex AI (si usas LLM_PROVIDER=vertex_ai)
# Login: gcloud auth application-default login
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1

# API keys (usa la de tu proveedor; las demas pueden quedar vacias)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Seguridad: herramientas permitidas para el agente
ALLOWED_TOOLS=bash,applescript