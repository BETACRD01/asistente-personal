# Hub (VPS)
HUB_WS_URL=wss://api.tudominio.com/ws/mac
DEVICE_TOKEN=change-me

# LLM (LiteLLM unifica todo)
# Ollama local (gratis)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

